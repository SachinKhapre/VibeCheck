# Server-side only. Never prefix with VITE_ — that would ship the key to the browser.
SERPAPI_KEY=
# OpenRouter, used by /api/extract. Free models work; see OPENROUTER_MODEL below.
OPENROUTER_API_KEY=

# Optional. Comma-separated fallback chain, tried in order when one is rate limited.
# OPENROUTER_MODEL=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free

# Optional. Hard ceiling on live SerpApi calls per server instance (free plan is 250/month).
SERPAPI_BUDGET=200
